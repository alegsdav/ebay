# Copy to .env.supabase (ignored by Git). Use `npx supabase secrets set --env-file .env.supabase`.
DISCORD_TOKEN=
# Discovery is not wired yet; keep false until the provider integration is complete.
FACEBOOK_MONITORING_ENABLED=false
# Reserved for the upcoming keyword-discovery adapter. Storing a key does not enable collection.
BRIGHT_DATA_API_KEY=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
ALLOWED_USER_IDS=
# Generate with: openssl rand -hex 32. Also put this value in Supabase Vault as scout_worker_secret.
WORKER_SECRET=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Planned Facebook Marketplace provider. Leave disabled until its connector is implemented and tested.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_MARKETPLACE_DATASET_ID=
FACEBOOK_PROVIDER=brightdata
FACEBOOK_MONITORING_ENABLED=false
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_POSTAL_CODE=
EBAY_ALLOW_AUCTIONS=false
DRY_RUN=true
# Start disabled so Discord setup can be tested without marketplace credentials.
CLOUD_MONITORING_ENABLED=false
CLOUD_ITEMS_PER_WATCH=20
MAX_LLM_CALLS_PER_DAY=300
EBAY_MAX_CALLS_PER_DAY=4000
TAX_RATE=0.08
BUYER_FEE_RATE=0
BUYER_FIXED_FEE=0
SELLING_FEE_RATE=0.15
SELLING_FIXED_FEE=0.30
OUTBOUND_SHIPPING=7
RISK_RESERVE_RATE=0.05
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the hosted runtime; don't add them here.
