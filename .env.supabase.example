# Copy to .env.supabase (ignored by Git). Use `npx supabase secrets set --env-file .env.supabase`.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
ALLOWED_USER_IDS=
# Generate with: openssl rand -hex 32. Also put this value in Supabase Vault as scout_worker_secret.
WORKER_SECRET=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_POSTAL_CODE=
# Watches both Buy It Now and auctions only when your eBay access permits auction search.
EBAY_ALLOW_AUCTIONS=false
# Facebook Marketplace leg kill switch. Needs BRIGHT_DATA_API_KEY as well; the eBay
# leg of every watch runs normally while it is off.
FACEBOOK_MONITORING_ENABLED=false
BRIGHT_DATA_API_KEY=
# Optional; blank entries use the defaults shown here.
# BRIGHT_DATA_DATASET_ID=gd_lvt9iwuh6fbcwmx1a
# Billed records per UTC month (every returned record counts, repeats included).
# BRIGHT_DATA_MAX_RECORDS_PER_MONTH=4500
# First search per watch vs. later hourly polls.
# BRIGHT_DATA_INITIAL_RECORDS=10
# BRIGHT_DATA_POLL_RECORDS=2
# BRIGHT_DATA_RECENT_FILTER=Last 24 hours
# Searches never use a smaller radius (Facebook pads small ones with unrelated items).
# BRIGHT_DATA_MIN_RADIUS=20
# Optional channel for per-search and per-listing diagnostics.
DEBUG_CHANNEL_ID=
DRY_RUN=true
# Start disabled so Discord setup can be tested without marketplace credentials.
CLOUD_MONITORING_ENABLED=false
CLOUD_ITEMS_PER_WATCH=20
MAX_LLM_CALLS_PER_DAY=300
EBAY_MAX_CALLS_PER_DAY=4000
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the hosted runtime; don't add them here.
