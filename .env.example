# Node 24+. No secrets are required for npm run demo.
DATABASE_PATH=./data/scout.sqlite
DRY_RUN=true
# Discovery is not wired yet; keep false until the provider integration is complete.
FACEBOOK_MONITORING_ENABLED=false
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional comma-separated IDs; empty allows guild members to manage their OWN watches.
ALLOWED_USER_IDS=
# Gemini supports a free tier for selected models; confirm availability in your account.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Optional alternate provider. Set LLM_PROVIDER=openai and an available structured-output model.
OPENAI_API_KEY=
# eBay production access requires appropriate approval. Start with sandbox credentials.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Restrict this deployment to US/USD in V1.
EBAY_POSTAL_CODE=
# Enable only if your approved eBay access permits auction search.
EBAY_ALLOW_AUCTIONS=false
MAX_PAGES_PER_WATCH=2
MAX_LLM_CALLS_PER_SCAN=50
# Daily request budgets persist across restarts, reset at midnight UTC, and include retries.
MAX_LLM_CALLS_PER_DAY=300
EBAY_MAX_CALLS_PER_DAY=4000
# ESTIMATES, not a tax or marketplace fee calculator. Shown in every preview.
TAX_RATE=0.08
BUYER_FEE_RATE=0
BUYER_FIXED_FEE=0
SELLING_FEE_RATE=0.15
SELLING_FIXED_FEE=0.30
OUTBOUND_SHIPPING=7
RISK_RESERVE_RATE=0.05
