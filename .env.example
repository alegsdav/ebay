# Local commands only (npm run register, npm run check:model). Node 24+.
# Hosted secrets live in .env.supabase; see .env.supabase.example.
DRY_RUN=true
# Facebook Marketplace leg kill switch. The Bright Data connector is a stub; keep false.
FACEBOOK_MONITORING_ENABLED=false
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional comma-separated IDs; empty allows guild members to manage their OWN watches.
ALLOWED_USER_IDS=
# Gemini supports a free tier for selected models; confirm availability in your account.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Optional alternate provider. Set LLM_PROVIDER=openai and an available structured-output model.
OPENAI_API_KEY=
